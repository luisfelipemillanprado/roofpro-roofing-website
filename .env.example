# Amazon SES — contact form email delivery (server-only)
# Required in every environment (.env.local locally, the VPS environment in production);
# without them /api/contact answers 502 and the form shows its error message.
AWS_REGION=us-east-1
SES_FROM=quotes@yourdomain.com
CONTACT_TO=leads@yourdomain.com

# AWS credentials resolve via the standard chain (env vars or an IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
